# T4-9: Minimal, isolated Docling parser container.
#
# This image runs the Docling document parser in a least-privilege sandbox:
#   - No network access (enforced by docker-compose network_mode: none)
#   - Read-only root filesystem
#   - Non-root user with no shell
#   - Bounded tmpfs for scratch space
#   - Fixed entrypoint (no shell injection)

FROM python:3.12-slim AS builder

RUN pip install --no-cache-dir docling rapidocr-onnxruntime

FROM python:3.12-slim

# Create a non-root user with no shell.
RUN groupadd --gid 10001 docling && \
    useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin docling

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy only the parser runner module.
COPY src/documind/parsers/ /app/documind/parsers/

WORKDIR /app

USER docling

# Fixed entrypoint — no shell, no arguments from the caller.
ENTRYPOINT ["python", "-m", "documind.parsers.docling_runner"]
