FROM python:3.12-slim AS builder

# Install build dependencies
RUN pip install --no-cache-dir \
    sentence-transformers==3.4.1 \
    fastapi==0.115.* \
    uvicorn[standard]==0.34.* \
    pydantic==2.*

# Download and cache the model at build time
RUN python -c "from sentence_transformers import CrossEncoder; CrossEncoder('BAAI/bge-reranker-v2-m3')"

# T7-22: Verify model digest when provided
ARG RERANKER_MODEL_DIGEST=""
RUN if [ -n "$RERANKER_MODEL_DIGEST" ]; then \
        actual=$(find /root/.cache/huggingface/hub/models--BAAI--bge-reranker-v2-m3 -type f | sort | xargs sha256sum | sha256sum | cut -d' ' -f1); \
        if [ "$actual" != "$RERANKER_MODEL_DIGEST" ]; then \
            echo "ERROR: Model digest mismatch. Expected=$RERANKER_MODEL_DIGEST Actual=$actual" >&2; \
            exit 1; \
        fi; \
        echo "Model digest verified: $actual"; \
    fi

FROM python:3.12-slim

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /root/.cache/huggingface /root/.cache/huggingface

COPY scripts/reranker_app.py /app/reranker_app.py

WORKDIR /app
EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/health')" || exit 1

CMD ["uvicorn", "reranker_app:app", "--host", "0.0.0.0", "--port", "8501"]
