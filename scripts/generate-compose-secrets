#!/usr/bin/env sh
# Generate unique, local-only evaluation secrets. Existing files are retained.
set -eu

secrets_dir=${1:-.secrets}
umask 077
mkdir -p "$secrets_dir"

random_hex() {
    od -An -N48 -tx1 /dev/urandom | tr -d ' \n'
}

write_secret() {
    secret_name=$1
    secret_path="$secrets_dir/$secret_name"
    if [ -e "$secret_path" ]; then
        return
    fi
    random_hex >"$secret_path"
}

write_username() {
    username_path="$secrets_dir/postgres_user"
    if [ -e "$username_path" ]; then
        return
    fi
    printf 'documind_%s\n' "$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n')" >"$username_path"
}

write_opensearch_password() {
    password_path="$secrets_dir/opensearch_admin_password"
    if [ -e "$password_path" ]; then
        existing_password=$(cat "$password_path")
        case "$existing_password" in
            *[A-Z]*[a-z]*[0-9]*[!A-Za-z0-9]*) return ;;
        esac
    fi
    printf 'Aa1!%s\n' "$(random_hex)" >"$password_path"
}

write_username
for secret_name in \
    postgres_password \
    redis_password \
    minio_root_user \
    minio_root_password \
    neo4j_password \
    grafana_admin_password \
    clickhouse_password \
    langfuse_nextauth_secret \
    langfuse_salt \
    langfuse_encryption_key \
    litellm_master_key \
    litellm_local_model_token; do
    write_secret "$secret_name"
done
write_opensearch_password

printf 'Generated Compose evaluation secrets in %s\n' "$secrets_dir"
