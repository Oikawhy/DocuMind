# Copy this file to .env and replace each OpenBao reference with a path owned
# by your deployment. Do not put secret values in this file or environment.
DOCUMIND_DATABASE_URL_REF=openbao://secret/data/documind/database#url
DOCUMIND_REDIS_URL_REF=openbao://secret/data/documind/redis#url
DOCUMIND_REDIS_STREAMS_URL_REF=openbao://secret/data/documind/redis#streams_url
DOCUMIND_MINIO_ACCESS_KEY_REF=openbao://secret/data/documind/minio#access_key
DOCUMIND_MINIO_SECRET_KEY_REF=openbao://secret/data/documind/minio#secret_key
DOCUMIND_CURSOR_HMAC_KEY_REF=openbao://secret/data/documind/api#cursor_hmac_key
DOCUMIND_NEO4J_AUTH_REF=openbao://secret/data/documind/neo4j#auth
DOCUMIND_OPENBAO_AUTH_REF=openbao://auth/kubernetes/documind
DOCUMIND_LANGFUSE_PUBLIC_KEY_REF=openbao://secret/data/documind/langfuse#public_key
DOCUMIND_LANGFUSE_SECRET_KEY_REF=openbao://secret/data/documind/langfuse#secret_key

# Non-secret deployment settings
DOCUMIND_OIDC_ISSUER=https://idp.example.invalid/realms/documind
DOCUMIND_OIDC_AUDIENCE=documind
DOCUMIND_TEMPORAL_HOST=temporal:7233
DOCUMIND_MINIO_ENDPOINT=minio:9000
DOCUMIND_QDRANT_HOST=qdrant
DOCUMIND_OPENSEARCH_HOST=opensearch
DOCUMIND_NEO4J_URI=bolt://neo4j:7687
DOCUMIND_OPENBAO_ADDR=http://openbao:8200
DOCUMIND_OTEL_EXPORTER_ENDPOINT=http://otel-collector:4317

# Application settings with release defaults
DOCUMIND_APP_NAME=DocuMind
DOCUMIND_DEBUG=false
DOCUMIND_API_V1_PREFIX=/v1
DOCUMIND_RELEASE_DIGEST=unavailable
DOCUMIND_MIGRATION_LEVEL=unavailable
DOCUMIND_MINIO_SECURE=false
DOCUMIND_MINIO_BUCKET=documind-documents
DOCUMIND_QDRANT_PORT=6333
DOCUMIND_QDRANT_COLLECTION=documind_chunks
DOCUMIND_OPENSEARCH_PORT=9200
DOCUMIND_OPENSEARCH_INDEX=documind_chunks
DOCUMIND_TEMPORAL_NAMESPACE=documind
DOCUMIND_OIDC_JWKS_CACHE_TTL=3600
DOCUMIND_OIDC_CLOCK_SKEW_SECONDS=30
DOCUMIND_LITELLM_PROXY_URL=http://litellm:4000
DOCUMIND_DEFAULT_MODEL_ROLE_KEYWORDS=local/qwen2.5-7b-instruct
DOCUMIND_DEFAULT_MODEL_ROLE_EXTRACT=local/qwen2.5-7b-instruct
DOCUMIND_DEFAULT_MODEL_ROLE_QUERY=local/qwen2.5-7b-instruct
DOCUMIND_UPLOAD_DEFAULT_MAX_BYTES=104857600
DOCUMIND_UPLOAD_HARD_CAP_BYTES=524288000
DOCUMIND_RETRIEVAL_MAX_CANDIDATES=100
DOCUMIND_RETRIEVAL_MAX_EVIDENCE=10
DOCUMIND_RETRIEVAL_RERANKER_THRESHOLD=0.10
DOCUMIND_RETRIEVAL_RRF_CONSTANT=60
DOCUMIND_RETRIEVAL_BUDGET_MS=2500
DOCUMIND_CHAT_ENABLED=false
DOCUMIND_CHAT_HISTORY_WINDOW=20
DOCUMIND_CHAT_HISTORY_MAX_TOKENS=4096
DOCUMIND_CHAT_COMPACTION_THRESHOLD=30
DOCUMIND_CHAT_RETENTION_DAYS=30
DOCUMIND_LANGFUSE_HOST=http://langfuse:3000
DOCUMIND_CLAMAV_HOST=clamav
DOCUMIND_CLAMAV_PORT=3310
DOCUMIND_SCIM_BEARER_TOKEN=

